/*
 * Bring-up credentials for the Golioth Pouch glue (CONFIG_ARDUINO_POUCH).
 *
 * Copy this file to 'pouch_credentials.h' and fill it in. That path is
 * gitignored, so real keys never enter the repository.
 *
 * The device certificate and key come from Golioth PKI:
 *   https://docs.golioth.io/connectivity/credentials/pki
 * Golioth reads the certificate's O= field as the project ID and CN= as the
 * device ID. Convert PEM to the DER arrays below with:
 *
 *   openssl x509 -in dev.crt.pem -outform DER | xxd -i
 *   openssl pkey -in dev.key.pem -outform DER | xxd -i
 *
 * Leave POUCH_WIFI_SSID empty to skip the built-in association and bring the
 * link up by hand from the Zephyr shell instead:
 *
 *   uart:~$ wifi connect -s <ssid> -p <psk> -k 1
 *
 * Either way the glue waits for an IPv4 address before starting Pouch.
 */

#pragma once

#define POUCH_WIFI_SSID ""
#define POUCH_WIFI_PSK  ""

static const unsigned char device_crt_der[] = {
	0x00, /* replace with your DER certificate */
};

static const unsigned char device_key_der[] = {
	0x00, /* replace with your DER private key */
};
